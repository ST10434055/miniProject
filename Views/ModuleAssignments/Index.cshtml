@model IEnumerable<ProgrammeManagementSystem.Models.ModuleAssignment>

@{
    ViewData["Title"] = "Module Assignments";
}

<div class="section-header">
    <h1 class="page-title mb-0">Module Assignments</h1>
    <a asp-action="Create" class="btn btn-primary">Add New Assignment</a>
</div>

<div class="table-card">
    <table class="table table-striped table-bordered table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Lecturer</th>
                <th>Module</th>
                <th class="actions-column">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Lecturer?.FirstName @item.Lecturer?.LastName</td>
                    <td>@item.Module?.ModuleName</td>
                    <td class="actions-column">
                        <a asp-action="Edit" asp-route-id="@item.AssignmentID" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.AssignmentID" class="btn btn-sm btn-info text-white">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.AssignmentID" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>