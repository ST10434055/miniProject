@model ProgrammeManagementSystem.Models.ModuleAssignment

@{
    ViewData["Title"] = "Delete Module Assignment";
}

<div class="details-card">
    <h1 class="page-title text-danger">Delete Module Assignment</h1>
    <p class="mb-4">Are you sure you want to delete this module assignment?</p>

    <dl class="row">
        <dt class="col-sm-3 details-label">Lecturer</dt>
        <dd class="col-sm-9">@Model.Lecturer?.FirstName @Model.Lecturer?.LastName</dd>

        <dt class="col-sm-3 details-label">Module</dt>
        <dd class="col-sm-9">@Model.Module?.ModuleName</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="AssignmentID" />
        <div class="form-actions">
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>