@model ProgrammeManagementSystem.Models.ModuleAssignment

@{
    ViewData["Title"] = "Module Assignment Details";
}

<div class="details-card">
    <h1 class="page-title">Module Assignment Details</h1>

    <dl class="row mb-0">
        <dt class="col-sm-3 details-label">Lecturer</dt>
        <dd class="col-sm-9">@Model.Lecturer?.FirstName @Model.Lecturer?.LastName</dd>

        <dt class="col-sm-3 details-label">Module</dt>
        <dd class="col-sm-9">@Model.Module?.ModuleName</dd>
    </dl>

    <div class="form-actions">
        <a asp-action="Edit" asp-route-id="@Model?.AssignmentID" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>