@model ProgrammeManagementSystem.Models.Module

@{
    ViewData["Title"] = "Delete Module";
}

<div class="details-card">
    <h1 class="page-title text-danger">Delete Module</h1>
    <p class="mb-4">Are you sure you want to delete this module?</p>

    <dl class="row">
        <dt class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.ModuleName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ModuleName)</dd>

        <dt class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.ModuleCode)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ModuleCode)</dd>

        <dt class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.Credits)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Credits)</dd>

        <dt class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.AcademicYear)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.AcademicYear)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ModuleID" />
        <div class="form-actions">
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>