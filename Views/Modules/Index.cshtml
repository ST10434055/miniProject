@model IEnumerable<ProgrammeManagementSystem.Models.Module>

@{
    ViewData["Title"] = "Modules";
}

<div class="section-header">
    <h1 class="page-title mb-0">Modules</h1>
    <a asp-action="Create" class="btn btn-primary">Add New Module</a>
</div>

<div class="table-card">
    <table class="table table-striped table-bordered table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.ModuleName)</th>
                <th>@Html.DisplayNameFor(model => model.ModuleCode)</th>
                <th>@Html.DisplayNameFor(model => model.Credits)</th>
                <th>@Html.DisplayNameFor(model => model.AcademicYear)</th>
                <th class="actions-column">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.ModuleName)</td>
                    <td>@Html.DisplayFor(modelItem => item.ModuleCode)</td>
                    <td>@Html.DisplayFor(modelItem => item.Credits)</td>
                    <td>@Html.DisplayFor(modelItem => item.AcademicYear)</td>
                    <td class="actions-column">
                        <a asp-action="Edit" asp-route-id="@item.ModuleID" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.ModuleID" class="btn btn-sm btn-info text-white">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.ModuleID" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>