@model ProgrammeManagementSystem.Models.Registration

@{
    ViewData["Title"] = "Delete Registration";
}

<div class="details-card">
    <h1 class="page-title text-danger">Delete Registration</h1>
    <p class="mb-4">Are you sure you want to delete this registration?</p>

    <dl class="row">
        <dt class="col-sm-3 details-label">Student</dt>
        <dd class="col-sm-9">@Model.Student?.FirstName @Model.Student?.LastName</dd>

        <dt class="col-sm-3 details-label">Module</dt>
        <dd class="col-sm-9">@Model.Module?.ModuleName</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="RegistrationID" />
        <div class="form-actions">
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>