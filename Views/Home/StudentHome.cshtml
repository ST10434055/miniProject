@{
    ViewData["Title"] = "Student Home";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Student Dashboard</h1>
    <p class="lead text-muted">Welcome to the student portal.</p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-md-5">
        <div class="card dashboard-card h-100">
            <div class="card-body text-center">
                <h4 class="card-title">Modules</h4>
                <p class="card-text">View all modules.</p>
                <a asp-controller="Modules" asp-action="Index" class="btn btn-primary">Open Modules</a>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card dashboard-card h-100">
            <div class="card-body text-center">
                <h4 class="card-title">Module Assignments</h4>
                <p class="card-text">View module assignments.</p>
                <a asp-controller="ModuleAssignments" asp-action="Index" class="btn btn-primary">Open Assignments</a>
            </div>
        </div>
    </div>
</div>