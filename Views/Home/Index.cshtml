@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Programme Management System</h1>
    <p class="lead text-muted">Please choose how you want to continue.</p>
</div>

<div class="row justify-content-center g-4">
    <div class="col-md-5">
        <div class="card dashboard-card h-100 text-center">
            <div class="card-body">
                <h3 class="mb-3">Student</h3>
                <p>Login or register as a student.</p>
                <a href="/Identity/Account/Login?role=Student" class="btn btn-primary me-2">Student Login</a>
                <a href="/Identity/Account/Register?role=Student" class="btn btn-outline-primary">Student Register</a>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card dashboard-card h-100 text-center">
            <div class="card-body">
                <h3 class="mb-3">Lecturer</h3>
                <p>Login or register as a lecturer.</p>
                <a href="/Identity/Account/Login?role=Lecturer" class="btn btn-success me-2">Lecturer Login</a>
                <a href="/Identity/Account/Register?role=Lecturer" class="btn btn-outline-success">Lecturer Register</a>
            </div>
        </div>
    </div>
</div>