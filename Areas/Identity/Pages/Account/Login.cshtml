@page
@model ProgrammeManagementSystem.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
    var selectedRole = Request.Query["role"].ToString();
    if (!string.IsNullOrEmpty(selectedRole))
    {
        Model.Input.Role = selectedRole;
    }
}

<div class="form-card">
    <h1 class="page-title">Login</h1>

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <form id="account" method="post">
                <h4 class="mb-3">Use your account to log in</h4>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Role" class="form-label"></label>
                    <select asp-for="Input.Role" class="form-select">
                        <option value="">Select Role</option>
                        <option value="Student">Student</option>
                        <option value="Lecturer">Lecturer</option>
                    </select>
                    <span asp-validation-for="Input.Role" class="text-danger"></span>
                </div>

                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe">
                        <input asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <div class="form-actions">
                    <button id="login-submit" type="submit" class="btn btn-primary">Log in</button>
                    <a href="/" class="btn btn-secondary">Back</a>
                </div>

                <div class="mt-3">
                    <p>
                        <a asp-page="./Register" asp-route-role="@Model.Input.Role">Register as a new user</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}